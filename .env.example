# Local SQLite development. Use postgresql+psycopg://user:password@host/dbname in production.
TRADEPILOT_DATABASE_URL=sqlite:///./tradepilot.db
TRADEPILOT_JWT_SECRET=replace-with-a-long-random-secret
TRADEPILOT_JWT_EXPIRE_MINUTES=60
TRADEPILOT_JWT_REFRESH_EXPIRE_DAYS=30
TRADEPILOT_BROKER_ENCRYPTION_KEY=
TRADEPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRADEPILOT_AI_PROVIDER=mock
TRADEPILOT_AI_API_KEY=
TRADEPILOT_AI_BASE_URL=
TRADEPILOT_AI_MODEL=
TRADEPILOT_AI_TIMEOUT_SECONDS=10
TRADEPILOT_AI_MAX_RETRIES=1
TRADEPILOT_AI_RATE_LIMIT=30
TRADEPILOT_AI_CACHE_TTL_SECONDS=300
TRADEPILOT_CACHE_BACKEND=memory
TRADEPILOT_ALERT_COOLDOWN_SECONDS=3600
TRADEPILOT_AUTO_CREATE_SCHEMA=true
